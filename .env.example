# Example environment configuration for local AZFlow development.
#
# Copy this file to `.env` and adjust the values as needed. Do not commit a
# real `.env` file; it is ignored by Git. These values contain no real secrets
# and are intended only for local Docker Compose development.

# API server binding used by AZFlow (python -m AZFlow / Uvicorn).
AZFLOW_API_HOST=0.0.0.0
AZFLOW_API_PORT=8000

# PostgreSQL credentials used by the `postgres` service and to build the
# database URL passed to the `azflow` service. The database is declared as
# configuration but is not connected to in the current slice.
POSTGRES_USER=azflow
POSTGRES_PASSWORD=azflow
POSTGRES_DB=azflow

# Host port used to reach the Docker Compose PostgreSQL from the host
# (for local integration tests). Defaults to 55432 to avoid clashing with a
# local PostgreSQL already using 5432.
AZFLOW_DB_HOST_PORT=55432

# Connection URL AZFlow receives (AZFLOW_DATABASE_URL). When running through
# Docker Compose this is derived from the POSTGRES_* values above and the
# `postgres` service host. Shown here for reference and local (non-Compose) use.
# AZFLOW_DATABASE_URL=postgresql://azflow:azflow@localhost:5432/azflow
