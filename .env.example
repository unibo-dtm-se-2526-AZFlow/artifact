# Example environment configuration for local AZFlow development.
#
# Copy this file to `.env` and adjust the values as needed. Do not commit a
# real `.env` file; it is ignored by Git.

# API server binding used by AZFlow.
AZFLOW_API_HOST=0.0.0.0
AZFLOW_API_PORT=8000

# Configured appointment sources. Numbering can be sparse: _1000 works alone.
# Values are loaded in ascending numeric order. The current adapter is "demo".
# Leave all AZFLOW_APPOINTMENT_SOURCE_<n> variables absent/empty to disable
# appointment sources (check-in then returns HTTP 503).
# Choosing demo provides synthetic appointments but never seeds PostgreSQL.
# Use 'poe dev-reset' explicitly to seed a disposable development database.
AZFLOW_APPOINTMENT_SOURCE_1=demo

# PostgreSQL connection used by AZFlow.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=azflow
POSTGRES_PASSWORD=azflow
POSTGRES_DB=azflow
